# WEBAGENT.KR — Next.js 앱 환경변수 (기술 스펙 §2)
# 복사: cp .env.example .env  후 값 채우기. .env 는 커밋 금지(.gitignore).
# n8n 컨테이너 자체 설정은 여기가 아니라 n8n.env 에 둔다 (결함 #16).

# ── Supabase (기획서 §15.2 — 클라우드 관리형) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 번들 / NEXT_PUBLIC_* 에 넣지 말 것. RLS 를 우회한다.
SUPABASE_SERVICE_ROLE_KEY=

# ── n8n 연동 ──────────────────────────────────────────────────────
# 진단 제출 시 호출할 n8n webhook 엔드포인트.
#   미설정: webhook 호출을 skip하고 diagnoses.status 는 PROCESSING 에 머문다(개발).
#   설정+실패: diagnoses.status=FAILED + TELEGRAM_ERROR_CHAT_ID 로 [진단 실패] 알림.
N8N_WEBHOOK_URL=
# Next.js -> n8n 요청의 X-Webhook-Secret 헤더 값 (n8n Webhook 노드에서 검증)
N8N_WEBHOOK_SECRET=

# ── AI (기획서 §9, OpenAI 확정) ──────────────────────────────────
OPENAI_API_KEY=

# ── Telegram (기획서 §16.5: 신규 진단/상담 + 에러 알림 겸용) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# ADMIN 과 동일 채널을 써도 무방
TELEGRAM_ERROR_CHAT_ID=

# ── 이메일 (P1 — 고객 결과 발송) ────────────────────────────────
RESEND_API_KEY=

# ── 분석 (P0 — 기획서 §14.4) ────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
