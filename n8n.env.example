# n8n 컨테이너 전용 환경변수 (docker-compose.yml 의 n8n 서비스가 env_file 로 읽음)
# 복사: cp n8n.env.example n8n.env  후 값 채우기. n8n.env 는 커밋 금지(.gitignore).
# Next.js 의 .env 와 분리한다 — 두 서비스가 같은 파일을 공유하지 않게 (기술 스펙 §2, 결함 #16).

# 워크플로우 자격증명 암호화 키. 한 번 정하면 바꾸지 말 것(기존 자격증명 복호화 불가).
# 생성 예: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# 배포 도메인 (Nginx Proxy Manager 뒤)
N8N_HOST=n8n.webagent.kr
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.webagent.kr/
GENERIC_TIMEZONE=Asia/Seoul

# Code 노드에서 외부 패키지 허용이 필요할 때만 (기술 스펙 §6). 초기엔 비워둬도 됨.
NODE_FUNCTION_ALLOW_EXTERNAL=
